{
  "title": "Mean Module",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Mean Module: a gritty",
        "analog-style mono synth.",
        "",
        "2 oscillators + noise,",
        "a saturating 2-pole",
        "Sallen-Key filter,",
        "2 ADSRs, LFO and a",
        "post-filter drive.",
        "",
        "Mono: last, low or",
        "high note priority.",
        "2x oversampled."
      ]
    },
    {
      "title": "Pages",
      "children": [
        {
          "title": "Main (root)",
          "lines": [
            "Cutoff, Res, Input,",
            "Grit, AmpA, AmpR,",
            "Drive, Vol.",
            "",
            "Grit: one knob for",
            "grit and darkness.",
            "Up = more drive and",
            "filter saturation,",
            "darker, a little",
            "noise and drift.",
            "Down = cleaner and",
            "brighter. Centre =",
            "the preset as saved."
          ]
        },
        {
          "title": "Oscillators",
          "lines": [
            "Wave1/2: Saw, Tri,",
            "Pulse or any mix.",
            "Shp1/2: pulse width,",
            "triangle skew or",
            "saw bow.",
            "Semi/Fine: osc 2",
            "tuning. Lvl1/2."
          ]
        },
        {
          "title": "Filter",
          "lines": [
            "Cutoff, Res.",
            "Input = drive into",
            "the filter. Hot input",
            "saturates and squeezes",
            "resonance; it",
            "self-oscillates.",
            "Mode: LP BP HP L+H B+L.",
            "Env/LFO to cutoff,",
            "Key tracking, Drive."
          ]
        },
        {
          "title": "Env 1",
          "lines": [
            "Filter and pitch FM",
            "envelope.",
            "Exponential ADSR,",
            "0.5 ms to 10 s."
          ]
        },
        {
          "title": "Env 2",
          "lines": [
            "Amplifier envelope.",
            "Exponential ADSR,",
            "0.5 ms to 10 s."
          ]
        },
        {
          "title": "Modulation",
          "lines": [
            "EFM 1/2: Env 1 pitch FM.",
            "LFM 1/2: LFO pitch FM.",
            "XMod: osc 2 FMs osc 1.",
            "Shape: LFO moves the",
            "shape of both oscs.",
            "Rate and wave of LFO."
          ]
        },
        {
          "title": "Matrix",
          "lines": [
            "Six slots: Src, Dst, Amt",
            "(-1..+1), Matrix 1-2,",
            "3-4 and 5-6 pages.",
            "Src: LFO Env1 Env2",
            "Vel Wheel AfterT StkX",
            "StkY Key Random.",
            "Dst: Pitch Pitch2",
            "Shape1/2 Lvl1/2 Noise",
            "Cutoff Res Input Drive",
            "Amp XMod LFO Rate.",
            "Slots add up; Off or",
            "0 amount does nothing."
          ]
        },
        {
          "title": "Signal path",
          "lines": [
            "Osc1 + Osc2 + Noise",
            "-> Input drive",
            "-> Sallen-Key filter",
            "-> VCA (Env 2)",
            "-> Drive -> Volume.",
            "Osc2 can FM Osc1",
            "(XMod). Env 1 and LFO",
            "feed cutoff, FM, shape.",
            "Matrix adds more.",
            "Grit sits on top."
          ]
        },
        {
          "title": "Play",
          "lines": [
            "Noise, Glide, Vib,",
            "Bend range, Drift,",
            "Legato, Volume.",
            "Drone: Off / Hold /",
            "Latch. Hold keeps amp",
            "open while a key is",
            "down. Latch keeps",
            "sounding after release",
            "until all-notes-off,",
            "a preset change or",
            "Drone Off."
          ]
        },
        {
          "title": "Perform",
          "lines": [
            "VCut, VAmp: velocity",
            "to cutoff and amp.",
            "AT: aftertouch target",
            "(Off Cut Vib Drv FM),",
            "Amt: amount.",
            "Prio: last/low/high.",
            "Oct, VibRt, Tune."
          ]
        },
        {
          "title": "Stick",
          "lines": [
            "Joystick emulation.",
            "StkX (knob 1) and",
            "StkY (knob 2) spring",
            "back to centre when",
            "you let go.",
            "X To: Bend, Vibrato",
            "Speed, Cutoff, Grit.",
            "Y To: Glide, Vibrato",
            "Depth, Cutoff, Grit,",
            "or Hold Toggle: hold",
            "Y fully down to flip",
            "Hold (other targets",
            "never touch Hold).",
            "Hold keeps notes",
            "sounding after release;",
            "a fresh press replaces them."
          ]
        },
        {
          "title": "Arp",
          "lines": [
            "Arp: Off, Up, Down,",
            "Up+Down, Random,",
            "As Played.",
            "Rate: 1/4 to 1/32",
            "(synced to Move).",
            "Oct: 1-3 octaves.",
            "Gate: note length;",
            "100% ties notes.",
            "Turn Hold on to",
            "latch a chord, then",
            "move the Stick."
          ]
        }
      ]
    },
    {
      "title": "Presets & State",
      "lines": [
        "Browse factory",
        "presets from the",
        "slot preset row.",
        "All parameters are",
        "saved with the set",
        "and in My Presets."
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Notes + velocity,",
        "pitch bend, mod wheel",
        "(vibrato), channel and",
        "poly aftertouch (any",
        "key), sustain pedal",
        "(CC64), CC121 reset,",
        "CC123 all notes off."
      ]
    }
  ]
}