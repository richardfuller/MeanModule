{
  "title": "Mean Module",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Gritty analog-style",
        "mono synth.",
        "",
        "2 oscillators +",
        "noise, a saturating",
        "2-pole Sallen-Key",
        "multimode filter,",
        "2 ADSRs, LFO and a",
        "post-filter drive.",
        "",
        "Mono, last-note",
        "priority (or low /",
        "high). Runs 2x",
        "oversampled."
      ]
    },
    {
      "title": "Pages",
      "children": [
        {
          "title": "Oscillators",
          "lines": [
            "Wave1/2: Saw, Tri,",
            "Pulse or any mix.",
            "Shp1/2: pulse width,",
            "triangle skew or",
            "saw bow.",
            "Semi/Fine: osc 2",
            "tuning. Lvl1/2."
          ]
        },
        {
          "title": "Filter",
          "lines": [
            "Cutoff, Res.",
            "Input = drive into",
            "the filter. Hot input",
            "saturates and squeezes",
            "resonance; it",
            "self-oscillates.",
            "Mode: LP BP HP L+H B+L.",
            "Env/LFO to cutoff,",
            "Key tracking, Drive."
          ]
        },
        {
          "title": "Env 1",
          "lines": [
            "Filter and pitch FM",
            "envelope.",
            "Exponential ADSR,",
            "0.5 ms to 10 s."
          ]
        },
        {
          "title": "Env 2",
          "lines": [
            "Amplifier envelope.",
            "Exponential ADSR,",
            "0.5 ms to 10 s."
          ]
        },
        {
          "title": "Modulation",
          "lines": [
            "EFM 1/2: Env 1 pitch FM.",
            "LFM 1/2: LFO pitch FM.",
            "XMod: osc 2 FMs osc 1.",
            "Shape: LFO moves the",
            "shape of both oscs.",
            "Rate and wave of LFO."
          ]
        },
        {
          "title": "Play",
          "lines": [
            "Noise, Glide, Vib,",
            "Bend range, Drift,",
            "Legato, Volume.",
            "Drone: Off / Hold /",
            "Latch. Hold keeps amp",
            "open while a key is",
            "down. Latch keeps",
            "sounding after release",
            "until all-notes-off,",
            "a preset change or",
            "Drone Off."
          ]
        },
        {
          "title": "Perform",
          "lines": [
            "VCut, VAmp: velocity",
            "to cutoff and amp.",
            "AT: aftertouch target",
            "(Off Cut Vib Drv FM),",
            "Amt: amount.",
            "Prio: last/low/high.",
            "Oct, VibRt, Tune."
          ]
        }
      ]
    },
    {
      "title": "Presets & State",
      "lines": [
        "Browse factory",
        "presets from the",
        "slot preset row.",
        "All parameters are",
        "saved with the set",
        "and in My Presets."
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Notes + velocity,",
        "pitch bend, mod wheel",
        "(vibrato), channel and",
        "poly aftertouch (any",
        "key), sustain pedal",
        "(CC64), CC121 reset,",
        "CC123 all notes off."
      ]
    }
  ]
}